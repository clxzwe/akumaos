animations {
    enabled = true

    bezier = apple_ease, 0.25, 1, 0.5, 1
    bezier = wind, 0.05, 0.9, 0.1, 1.05
    bezier = win_out, 0.3, -0.3, 0, 1
    bezier = liner, 1, 1, 1, 1

    animation = windows, 1, 5, wind, slide
    animation = windowsIn, 1, 5, wind, slide
    animation = windowsOut, 1, 4, win_out, slide
    animation = windowsMove, 1, 4, wind, slide
    animation = border, 1, 10, default
    animation = fade, 1, 5, default
    animation = workspaces, 1, 3, apple_ease, slide
}
